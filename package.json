{
  "name": "apollocut",
  "productName": "ApolloCut",
  "version": "1.5.0",
  "description": "ApolloCut \u2014 the free & open-source desktop video editor. Non-linear editing, keyframed effects, audio mixing and a bundled FFmpeg pro render engine.",
  "main": "main/main.js",
  "license": "MIT",
  "author": "ApolloCut contributors",
  "homepage": "https://github.com/apollocut/apollocut",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  }
}